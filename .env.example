# =====================================================================
# Inventory Manager -- environment template
# =====================================================================
# Copy to .env next to docker-compose.yml, fill in real values, then:
#     chmod 600 .env
#
# .env is never committed. This file documents every variable the stack reads
# so a new deployer knows exactly what is needed without ever seeing a secret.
# Names are SCREAMING_SNAKE_CASE, prefixed by concern.
#
# Two conventions worth knowing before editing:
#
#   * No inline comments after a value. This file is read three ways -- Docker
#     Compose's env_file parser, `source` in the backup and restore scripts,
#     and Spring's relaxed binding -- and they do not agree about where a
#     trailing `#` ends a value. Comments go on their own line.
#   * No quotes around values unless the value genuinely contains them. Compose
#     keeps quotes it finds; bash strips them. A password wrapped in quotes here
#     is a password that works in the scripts and fails in the app.
# =====================================================================

# ---- Application image ----------------------------------------------
# Always a real version tag in production. Never `latest`: an admin updating
# should be choosing a known version, not drifting onto whatever is newest.
APP_IMAGE=inventory-manager:0.1.0

# The hostname the certificate is issued for, and that nginx serves.
APP_HOSTNAME=inventory.example.com

# ---- Database --------------------------------------------------------
# DB_HOST is `postgres` while the database runs in this stack. To externalize
# it later: stand up the new instance, restore with the runbook in
# docs/RUNBOOK.md, change DB_HOST here, set DEPLOY_MODE=direct below, and stop
# starting the local service.
#
# DB_USER must be able to DROP and CREATE the database, because that is step 2
# of every restore -- see scripts/setup-database.sql. In the default stack this
# is true because DB_USER is the Postgres container's own superuser; against an
# external instance it has to be granted (`ALTER ROLE ... CREATEDB`). A role
# without it turns the recovery procedure into a permission error found at the
# worst possible moment.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=inventory_manager
DB_USER=inventory_manager
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# ---- First sign-in ---------------------------------------------------
# Used once, only when the user table is empty. The account is created with
# must-change-password set. Leave blank to have one generated and printed to the
# container log at first startup instead.
APP_ADMIN_USERNAME=admin
APP_ADMIN_INITIAL_PASSWORD=

# ---- Sessions and logging --------------------------------------------
APP_SESSION_TIMEOUT=8h
APP_LOG_LEVEL=INFO

# ---- Attachments -----------------------------------------------------
# Attachment bytes are files on a volume, not rows in Postgres, which is why
# backup.sh produces two artefacts rather than one. This path is inside the app
# container; the volume behind it is declared in docker-compose.yml.
APP_ATTACHMENTS_DIRECTORY=/var/lib/inventory-manager/attachments

# 25 MiB. This has a twin: `client_max_body_size` in
# deploy/nginx/default.conf.template. Raise one without the other and an
# oversized upload is rejected by whichever is lower, with the proxy's error
# rather than the application's -- so change them together.
APP_ATTACHMENTS_MAX_BYTES=26214400

# ---- LDAP (optional) -------------------------------------------------
# Authentication only. The Plugin Framework's directory sync is a separate
# thing entirely and must never touch credentials or lockout state.
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.example.com:389/dc=example,dc=com
LDAP_USER_SEARCH_BASE=ou=people
LDAP_USER_SEARCH_FILTER=(uid={0})
LDAP_BIND_DN=cn=service,dc=example,dc=com
LDAP_BIND_PASSWORD=

# ---- Active Directory (optional) -------------------------------------
AD_ENABLED=false
AD_DOMAIN=corp.example.com
AD_URL=ldap://dc01.corp.example.com:389

# ---- Plugin secrets --------------------------------------------------
# plugin.configuration stores only the reference name, e.g.
#   {"api_token_ref": "PLUGIN_ZABBIX_API_TOKEN"}
# and the plugin resolves the actual value from here at sync time. A secret is
# never stored in the database, which is what keeps a database dump free of
# credentials -- including the dumps backup.sh copies off-box every night.
# PLUGIN_ZABBIX_API_TOKEN=
# PLUGIN_NETBOX_API_TOKEN=
# PLUGIN_DIRECTORY_BIND_PASSWORD=

# ---- Where the database and the app actually are ---------------------
# `compose` (the default) means both are services in deploy/docker-compose.yml
# and the backup and restore scripts reach them with `docker compose exec`.
#
# `direct` means Postgres is reachable at DB_HOST:DB_PORT with the client tools
# on PATH -- an externalized or managed database, or a restore rehearsal on a
# machine with no Docker. In that mode the scripts cannot guess how the
# application itself is started, so tell them; left blank, restore.sh stops and
# asks a human rather than restoring underneath a running application.
DEPLOY_MODE=compose
# APP_STOP_COMMAND=systemctl stop inventory-manager
# APP_START_COMMAND=systemctl start inventory-manager
# APP_HEALTH_URL=http://localhost:8080/actuator/health

# ---- Backups ---------------------------------------------------------
# Nightly pg_dump -Fc plus a tar of the attachment directory, 6-month rolling
# retention. The export destination is an operational choice, not a hardcoded
# target: LOCAL_PATH, SFTP, or S3.
#
# Staging is where the two artefacts are built before being copied out. It is
# on the same disk as the database by definition, so it is never the backup --
# BACKUP_DESTINATION_PATH is. Point that somewhere the loss of this VM does not
# take with it.
BACKUP_STAGING_DIR=/var/backups/inventory-manager
BACKUP_DESTINATION_TYPE=LOCAL_PATH
BACKUP_DESTINATION_PATH=/mnt/backups/inventory-manager
BACKUP_DESTINATION_CREDENTIALS_REF=
BACKUP_RETENTION_DAYS=180

# ---- TLS -------------------------------------------------------------
APP_TLS_ACME_EMAIL=ops@example.com
