# =====================================================================
# Inventory Manager -- environment template
# =====================================================================
# Copy to .env next to docker-compose.yml, fill in real values, then:
#     chmod 600 .env
#
# .env is never committed. This file documents every variable the stack reads
# so a new deployer knows exactly what is needed without ever seeing a secret.
# Names are SCREAMING_SNAKE_CASE, prefixed by concern.
# =====================================================================

# ---- Application image ----------------------------------------------
# Always a real version tag in production. Never `latest`: an admin updating
# should be choosing a known version, not drifting onto whatever is newest.
APP_IMAGE=inventory-manager:0.1.0

# The hostname the certificate is issued for, and that nginx serves.
APP_HOSTNAME=inventory.example.com

# ---- Database --------------------------------------------------------
# DB_HOST is `postgres` while the database runs in this stack. To externalize
# it later: stand up the new instance, restore with the runbook in
# docs/RUNBOOK.md, change DB_HOST here, and stop starting the local service.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=inventory_manager
DB_USER=inventory_manager
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# ---- First sign-in ---------------------------------------------------
# Used once, only when the user table is empty. The account is created with
# must-change-password set. Leave blank to have one generated and printed to the
# container log at first startup instead.
APP_ADMIN_USERNAME=admin
APP_ADMIN_INITIAL_PASSWORD=

# ---- Sessions --------------------------------------------------------
APP_SESSION_TIMEOUT=8h
APP_LOG_LEVEL=INFO

# ---- LDAP (optional) -------------------------------------------------
# Authentication only. The Plugin Framework's directory sync is a separate
# thing entirely and must never touch credentials or lockout state.
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.example.com:389/dc=example,dc=com
LDAP_USER_SEARCH_BASE=ou=people
LDAP_USER_SEARCH_FILTER=(uid={0})
LDAP_BIND_DN=cn=service,dc=example,dc=com
LDAP_BIND_PASSWORD=

# ---- Active Directory (optional) -------------------------------------
AD_ENABLED=false
AD_DOMAIN=corp.example.com
AD_URL=ldap://dc01.corp.example.com:389

# ---- Plugin secrets (Milestone 6) ------------------------------------
# plugin.configuration stores only the reference name, e.g.
#   {"api_token_ref": "PLUGIN_ZABBIX_API_TOKEN"}
# and the plugin resolves the actual value from here at sync time.
# PLUGIN_ZABBIX_API_TOKEN=
# PLUGIN_NETBOX_API_TOKEN=

# ---- Backups ---------------------------------------------------------
# Nightly pg_dump -Fc, 6-month rolling retention. The export destination is an
# operational choice, not a hardcoded target.
BACKUP_DESTINATION_TYPE=LOCAL_PATH        # LOCAL_PATH | SFTP | S3
BACKUP_DESTINATION_PATH=/mnt/backups/inventory-manager
BACKUP_DESTINATION_CREDENTIALS_REF=
BACKUP_RETENTION_DAYS=180

# ---- TLS -------------------------------------------------------------
APP_TLS_ACME_EMAIL=ops@example.com
