# Inventory Manager reverse proxy.
#
# This is a TEMPLATE, not a finished config. The nginx image's entrypoint runs
# envsubst over /etc/nginx/templates/*.template at startup, which is what turns
# ${APP_HOSTNAME} into the real hostname. It only substitutes variables that
# actually exist in the environment, so nginx's own $host, $remote_addr, and
# friends are left alone.
#
# The application never manages TLS certificates. It speaks plain HTTP on the
# internal Docker network and always sits behind this proxy.

upstream inventory_app {
    server app:8080;
}

# Port 80 exists for the ACME challenge and to redirect everything else.
server {
    listen 80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOSTNAME};

    # Written by certbot into the shared volume. Before the first certificate
    # is issued, run `certbot certonly --webroot -w /var/www/certbot -d <host>`
    # once; renewals after that are unattended.
    ssl_certificate     /etc/letsencrypt/live/${APP_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_HOSTNAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # Attachments and logo uploads; the application caps sizes itself as well.
    client_max_body_size 25m;

    location / {
        proxy_pass http://inventory_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # The actuator is for the container health check and the operator, not the
    # internet. Only the internal Docker network may reach it.
    location /actuator/ {
        allow 172.16.0.0/12;
        allow 127.0.0.1;
        deny all;
        proxy_pass http://inventory_app;
        proxy_set_header Host $host;
    }
}
